# Environment Variables for Server Deployment

# Port (Render/Railway sets this automatically, default is 5000)
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas connection string in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mount-carmel-school?retryWrites=true&w=majority

# Secret key for signing JWT auth tokens
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Frontend URL (Used for CORS permissions)
CLIENT_URL=https://your-frontend.vercel.app

# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Admin email to receive enquiry notifications
NOTIFY_EMAIL=abhinandanp359@gmail.com
