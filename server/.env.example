PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/school_db
JWT_SECRET=your_super_secret_jwt_key_here
FRONTEND_URL=http://localhost:3000

# Default Admin Password for initial seed (MUST BE STRONG: at least 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 special char)
DEFAULT_ADMIN_PASSWORD=YourStrongPasswordHere123!@

# Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
